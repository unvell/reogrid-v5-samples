<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe only hides the console window on Windows; macOS and Linux are unaffected. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ReoGridSamples.LiveMarketGrid</RootNamespace>
    <AssemblyName>LiveMarketGrid</AssemblyName>
    <AvaloniaVersion>11.3.17</AvaloniaVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
  </ItemGroup>

  <!-- ReoGrid One from the UNVELL package feed (see the repository README for the one-time feed setup). -->
  <ItemGroup Condition="'$(ReoGridSource)' == ''">
    <PackageReference Include="unvell.ReoGrid.One.Avalonia" Version="$(ReoGridVersion)" />
  </ItemGroup>

  <!-- For ReoGrid maintainers: build against a local checkout of the library instead of the package.
       dotnet build -p:ReoGridSource=C:\path\to\reogrid-v5 -->
  <ItemGroup Condition="'$(ReoGridSource)' != ''">
    <ProjectReference Include="$(ReoGridSource)\ReoGrid.One.Avalonia\ReoGrid.One.Avalonia.csproj" />
  </ItemGroup>

</Project>
