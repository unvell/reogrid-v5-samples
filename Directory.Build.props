<Project>

  <!-- Settings shared by every sample in this repository. -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <!-- The ReoGrid One version every sample builds against. Override on the command line:
         dotnet build -p:ReoGridVersion=5.2.0 -->
    <ReoGridVersion Condition="'$(ReoGridVersion)' == ''">5.2.0</ReoGridVersion>
  </PropertyGroup>

</Project>
